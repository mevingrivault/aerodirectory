generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "osm"]
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  VISITOR
  MEMBER
  MODERATOR
  ADMIN

  @@schema("public")
}

enum UserStatus {
  ACTIVE
  BANNED

  @@schema("public")
}

enum AerodromeStatus {
  OPEN
  CLOSED
  RESTRICTED
  SEASONAL

  @@schema("public")
}

enum AerodromeType {
  SMALL_AIRPORT
  INTERNATIONAL_AIRPORT
  GLIDER_SITE
  ULTRALIGHT_FIELD
  HELIPORT
  ALTIPORT
  MILITARY
  SEAPLANE_BASE
  OTHER

  @@schema("public")
}

enum SurfaceType {
  ASPHALT
  CONCRETE
  GRASS
  GRAVEL
  DIRT
  WATER
  OTHER

  @@schema("public")
}

enum FrequencyType {
  TWR
  AFIS
  ATIS
  APP
  UNICOM
  GROUND
  CTAF
  FIS
  OTHER

  @@schema("public")
}

enum FuelType {
  AVGAS_100LL
  UL91
  JET_A1
  SP98

  @@schema("public")
}

enum PaymentType {
  CARD
  CASH
  TOTAL_CARD
  BP_CARD
  OTHER

  @@schema("public")
}

enum VisitStatus {
  SEEN
  VISITED
  FAVORITE

  @@schema("public")
}

enum ContentStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED

  @@schema("public")
}

enum PhotoStatus {
  PENDING
  SCANNING
  REJECTED
  READY

  @@schema("public")
}

enum SyncSource {
  OPENAIP
  AIRSPACES
  OSM
  REGIONS
  RGPD
  OURAIRPORTS
  COMMONS
  OBSTACLES
  PROTECTED_AREAS
  WIND_CLIMATE
  AERIAL_LINES
  CAM_AERO

  @@schema("public")
}

enum SyncRunType {
  SCHEDULED
  MANUAL
  RETRY
  RECOVERY

  @@schema("public")
}

enum SyncRunStatus {
  QUEUED
  RETRY_SCHEDULED
  IN_PROGRESS
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED

  @@schema("public")
}

enum SyncStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED

  @@schema("public")
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  EMAIL_CHANGE
  TOTP_ENABLE
  TOTP_DISABLE
  ACCOUNT_CREATE
  ACCOUNT_DELETE
  ROLE_CHANGE
  COMMENT_CREATE
  COMMENT_DELETE
  CORRECTION_PROPOSE
  REPORT_CREATE
  ADMIN_ACTION
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  PHOTO_UPLOAD
  PHOTO_APPROVE
  PHOTO_REJECT
  PHOTO_DELETE
  USER_BAN
  USER_UNBAN
  ACCOUNT_LOCKED
  CONTENT_MODERATED
  EVENT_CREATE
  EVENT_DELETE
  COMMENT_APPROVE
  COMMENT_REJECT
  EVENT_APPROVE
  EVENT_REJECT
  COMMUNITY_INFO_PROPOSE

  @@schema("public")
}

enum EventType {
  CAFE_CROISSANT
  OPEN_DAY
  AIRSHOW
  OTHER

  @@schema("public")
}

// ─── User ────────────────────────────────────────────────

model User {
  id                         String     @id @default(cuid())
  email                      String     @unique
  emailVerified              DateTime?
  passwordHash               String
  totpSecret                 String?
  totpEnabled                Boolean    @default(false)
  status                     UserStatus @default(ACTIVE)
  bannedAt                   DateTime?
  bannedReason               String?
  bannedById                 String?
  role                       Role       @default(MEMBER)
  displayName                String?    @unique
  bio                        String?
  avatarKey                  String?
  avatarMimeType             String?
  communityConsentAt         DateTime?
  showCommunityProfile       Boolean    @default(false)
  showCommunityContributions Boolean    @default(true)
  showCommunityPhotos        Boolean    @default(true)
  showPublicSearches         Boolean    @default(false)
  homeAerodromeId            String?
  failedLoginAttempts        Int        @default(0)
  lockedUntil                DateTime?
  // Bumped on password change/reset, TOTP disable and ban: every access and
  // refresh token carries the version it was issued with and dies on mismatch.
  tokenVersion               Int        @default(0)
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  homeAerodrome     Aerodrome?        @relation("UserHomeAerodrome", fields: [homeAerodromeId], references: [id])
  visits            Visit[]
  comments          Comment[]         @relation("CommentAuthor")
  deletedComments   Comment[]         @relation("CommentDeletedBy")
  corrections       Correction[]
  reports           Report[]
  aircraftProfiles  AircraftProfile[]
  savedSearches     SavedSearch[]
  followers         Follow[]          @relation("UserFollowers")
  following         Follow[]          @relation("UserFollowing")
  aerodromeLists    AerodromeList[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  emailTokens       EmailToken[]
  bannedBy          User?             @relation("UserBans", fields: [bannedById], references: [id], onDelete: SetNull)
  bannedUsers       User[]            @relation("UserBans")
  photos            Photo[]
  reviewedPhotos    Photo[]           @relation("PhotoReviewedBy")
  triggeredSyncRuns SyncRun[]         @relation("SyncRunTriggeredBy")
  events            AerodromeEvent[]
  communityInfos    CommunityInfo[]

  @@index([email])
  @@index([status])
  @@map("users")
  @@schema("public")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
  @@map("follows")
  @@schema("public")
}

model EmailToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  type      String // "verify" | "reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_tokens")
  @@schema("public")
}

// ─── Aerodrome ───────────────────────────────────────────

model Aerodrome {
  id                  String          @id @default(cuid())
  name                String
  icaoCode            String?         @unique
  iataCode            String?
  altIdentifier       String?
  latitude            Float
  longitude           Float
  elevation           Int? // feet
  magneticDeclination Float?
  city                String?
  region              String?
  department          String?
  countryCode         String          @default("FR")
  aerodromeType       AerodromeType   @default(SMALL_AIRPORT)
  status              AerodromeStatus @default(OPEN)
  ppr                 Boolean         @default(false)
  privateUse          Boolean         @default(false)
  skydiveActivity     Boolean         @default(false)
  winchOnly           Boolean         @default(false)
  aipLink             String?
  vacLink             String?
  websiteUrl          String?
  wikipediaUrl        String?
  // From openAIP: [{ label, number, remarks }], free-text contact, opening
  // slots [{ day, from, to, byNotam, holidaysExcluded, remarks }] and remarks.
  phones              Json            @default("[]")
  contactInfo         String?
  openingHours        Json            @default("[]")
  sourceRemarks       String?
  description         String?
  handlingFacilities  Int[]           @default([])
  passengerFacilities Int[]           @default([])
  hasRestaurant       Boolean         @default(false)
  hasBikes            Boolean         @default(false)
  hasTransport        Boolean         @default(false)
  hasAccommodation    Boolean         @default(false)
  hasMaintenance      Boolean         @default(false)
  hasHangars          Boolean         @default(false)
  nightOperations     Boolean         @default(false)

  // ─── Source tracking ──────────────────────────
  source        String? // e.g. "openaip", "sia", "manual"
  sourceId      String? // external unique ID from data source
  sourceRawHash String? // hash of raw payload for change detection
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runways        Runway[]
  frequencies    Frequency[]
  fuels          Fuel[]
  visits         Visit[]
  comments       Comment[]
  corrections    Correction[]
  reports        Report[]
  listItems      AerodromeListItem[]
  homeUsers      User[]              @relation("UserHomeAerodrome")
  photos         Photo[]
  commonsPhoto   CommonsPhoto?
  events         AerodromeEvent[]
  communityInfos CommunityInfo[]
  webcams        Webcam[]

  @@unique([source, sourceId])
  @@index([latitude, longitude])
  @@index([icaoCode])
  @@index([name])
  @@index([city])
  @@index([region])
  @@index([countryCode])
  @@index([aerodromeType])
  @@map("aerodromes")
  @@schema("public")
}

model Runway {
  id                 String      @id @default(cuid())
  aerodromeId        String
  identifier         String // e.g. "09/27"
  length             Int // meters
  width              Int? // meters
  trueHeading        Int?
  mainRunway         Boolean     @default(false)
  operations         Int?
  surface            SurfaceType
  surfaceComposition Int[]       @default([])
  lighting           Boolean     @default(false)
  remarks            String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@map("runways")
  @@schema("public")
}

model Frequency {
  id          String        @id @default(cuid())
  aerodromeId String
  type        FrequencyType
  mhz         Float
  isPrimary   Boolean       @default(false)
  callsign    String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@map("frequencies")
  @@schema("public")
}

model Fuel {
  id                String      @id @default(cuid())
  aerodromeId       String
  type              FuelType
  available         Boolean     @default(true)
  selfService       Boolean     @default(false)
  availabilityHours String? // e.g. "08:00-18:00"
  paymentType       PaymentType @default(CARD)
  remarks           String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@unique([aerodromeId, type])
  @@map("fuels")
  @@schema("public")
}

// ─── Collaborative features ─────────────────────────────

model Visit {
  id          String      @id @default(cuid())
  userId      String
  aerodromeId String
  status      VisitStatus @default(VISITED)
  visitedAt   DateTime    @default(now())
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@unique([userId, aerodromeId])
  @@map("visits")
  @@schema("public")
}

model Comment {
  id            String        @id @default(cuid())
  userId        String
  aerodromeId   String
  parentId      String?
  content       String
  contentStatus ContentStatus @default(PENDING)
  deletedAt     DateTime?
  deletedReason String?
  deletedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User      @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  deletedBy User?     @relation("CommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@index([aerodromeId])
  @@index([aerodromeId, parentId, contentStatus, deletedAt])
  @@index([parentId])
  @@index([deletedAt])
  @@map("comments")
  @@schema("public")
}

model Correction {
  id            String        @id @default(cuid())
  userId        String
  aerodromeId   String
  field         String
  currentValue  String?
  proposedValue String
  reason        String?
  contentStatus ContentStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@map("corrections")
  @@schema("public")
}

model Report {
  id            String        @id @default(cuid())
  userId        String
  aerodromeId   String
  targetType    String // "comment" | "correction" | "photo"
  targetId      String
  reason        String
  contentStatus ContentStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@map("reports")
  @@schema("public")
}

model AerodromeEvent {
  id            String        @id @default(cuid())
  userId        String
  aerodromeId   String
  type          EventType
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  contentStatus ContentStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@index([aerodromeId, contentStatus, startDate])
  @@map("aerodrome_events")
  @@schema("public")
}

enum CommunityInfoKind {
  FUEL_PRICE
  LANDING_FEE
  HANGAR
  WEBCAM

  @@schema("public")
}

// Practical information only members know (fuel prices, fees, hangar, webcam
// links), dated and moderated like corrections. `data` holds the fields of
// its kind, validated by CommunityInfoCreateSchema in packages/shared. The
// sheet shows the newest approved entry per kind and key (fuel type, aircraft
// category, webcam URL); older ones stay as history.
model CommunityInfo {
  id            String            @id @default(cuid())
  userId        String
  aerodromeId   String
  kind          CommunityInfoKind
  key           String // e.g. "AVGAS_100LL", "ULM", "-" for a hangar
  data          Json
  observedAt    DateTime // date the member saw the price or fee
  contentStatus ContentStatus     @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@index([aerodromeId, contentStatus, kind, key, observedAt])
  @@index([contentStatus, createdAt])
  @@map("community_infos")
  @@schema("public")
}

// ─── Flight Planner ──────────────────────────────────────

model AircraftProfile {
  id              String        @id @default(cuid())
  userId          String
  name            String // e.g. "My C172"
  tas             Float // knots
  fuelConsumption Float // liters per hour
  hourlyCost      Float // euros per hour
  fuelRange       Float // nautical miles
  minRunwayLength Int // meters
  allowedSurfaces SurfaceType[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("aircraft_profiles")
  @@schema("public")
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  scope     String   @default("search") // "search" | "planner"
  isPublic  Boolean  @default(false)
  params    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@map("saved_searches")
  @@schema("public")
}

model AerodromeList {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items AerodromeListItem[]

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@map("aerodrome_lists")
  @@schema("public")
}

model AerodromeListItem {
  id          String   @id @default(cuid())
  listId      String
  aerodromeId String
  note        String?
  createdAt   DateTime @default(now())

  list      AerodromeList @relation(fields: [listId], references: [id], onDelete: Cascade)
  aerodrome Aerodrome     @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@unique([listId, aerodromeId])
  @@index([aerodromeId])
  @@map("aerodrome_list_items")
  @@schema("public")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  linkUrl   String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
  @@schema("public")
}

// ─── Audit Log ───────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("public")
}

model SyncRun {
  id                String        @id @default(cuid())
  source            SyncSource
  runType           SyncRunType
  scope             String?
  status            SyncRunStatus @default(QUEUED)
  attempt           Int           @default(1)
  scheduledFor      DateTime
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  summary           Json?
  errorMessage      String?
  recipients        String[]
  nextRetryAt       DateTime?
  triggeredByUserId String?
  workerId          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  triggeredBy User?         @relation("SyncRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  steps       SyncRunStep[]

  @@index([source, status])
  @@index([status, scheduledFor])
  @@index([nextRetryAt])
  @@index([createdAt])
  @@map("sync_runs")
  @@schema("public")
}

model SyncRunStep {
  id           String         @id @default(cuid())
  runId        String
  stepKey      String
  stepOrder    Int
  status       SyncStepStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  metrics      Json?
  checkpoint   Json?
  artifactPath String?
  logSummary   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  run SyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepKey])
  @@index([status])
  @@index([runId, stepOrder])
  @@map("sync_run_steps")
  @@schema("public")
}

// ─── Photo ───────────────────────────────────────────────

model Photo {
  id               String      @id @default(cuid())
  userId           String
  aerodromeId      String
  originalFilename String?
  storedFilename   String // UUID-based, never the original name
  storedKey        String // S3 object key
  mimeType         String // final MIME type after conversion
  size             Int // bytes after processing
  width            Int?
  height           Int?
  status           PhotoStatus @default(PENDING)
  rejectedReason   String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("PhotoReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  aerodrome  Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@index([aerodromeId, status])
  @@index([status, createdAt])
  @@index([userId])
  @@index([reviewedById])
  @@map("photos")
  @@schema("public")
}

// ─── Airspace ────────────────────────────────────────────

enum ObstacleType {
  OBSTACLE
  CHIMNEY
  BUILDING
  WIND_TURBINE
  TOWER

  @@schema("public")
}

// Vertical obstacles (wind turbines, towers, chimneys…) from openAIP, shown
// around each aerodrome. Replaced as a whole by each sync.
model Obstacle {
  id         String       @id @default(cuid())
  source     String // "openaip"
  sourceId   String
  name       String?
  type       ObstacleType
  latitude   Float
  longitude  Float
  heightM    Int? // above ground
  elevationM Int? // above mean sea level, as openAIP gives it
  createdAt  DateTime     @default(now())

  @@unique([source, sourceId])
  @@index([latitude, longitude])
  @@map("obstacles")
  @@schema("public")
}

enum ProtectedAreaKind {
  NATIONAL_PARK // core area only
  NATURE_RESERVE
  BIOTOPE_PROTECTION // arrêté de protection de biotope
  BIRD_SPA // Natura 2000, Birds Directive
  SILENCE_ZONE

  @@schema("public")
}

// Protected areas that matter when overflying (IGN BD TOPO, Licence
// Ouverte). Geometries are simplified for display; the bounding box finds
// the areas around an aerodrome. Replaced as a whole by each sync.
model ProtectedArea {
  id        String            @id @default(cuid())
  source    String // "ign-bdtopo"
  sourceId  String // BD TOPO cleabs
  name      String?
  kind      ProtectedAreaKind
  detail    String? // nature_detaillee, e.g. "Réserve naturelle nationale"
  geometry  Json // GeoJSON Polygon or MultiPolygon, WGS 84
  minLat    Float
  maxLat    Float
  minLon    Float
  maxLon    Float
  createdAt DateTime          @default(now())

  @@unique([source, sourceId])
  @@index([minLat, maxLat, minLon, maxLon])
  @@map("protected_areas")
  @@schema("public")
}

enum AerialLineKind {
  POWER_LINE // high-voltage line
  CABLE // chairlift, cable car, material ropeway, zip line

  @@schema("public")
}

// Overhead wires near aerodromes, from IGN BD TOPO (Licence Ouverte):
// power lines of 63 kV and more, and aerial ropeways. Replaced as a whole by
// each sync; the bounding box finds those around an aerodrome.
model AerialLine {
  id        String         @id @default(cuid())
  source    String // "ign-bdtopo"
  sourceId  String // BD TOPO cleabs
  kind      AerialLineKind
  detail    String? // voltage ("225 kV") or ropeway type
  name      String?
  geometry  Json // GeoJSON LineString, WGS 84, no altitude
  minLat    Float
  maxLat    Float
  minLon    Float
  maxLon    Float
  createdAt DateTime       @default(now())

  @@unique([source, sourceId])
  @@index([minLat, maxLat, minLon, maxLon])
  @@map("aerial_lines")
  @@schema("public")
}

// Wind climatology of a Météo-France station (hourly data, Licence
// Ouverte), for the prevailing-wind rose of nearby aerodromes. `counts` is
// 36 directions (0°, 10°, … 350°, where the wind blows from) × 3 speed
// classes (1–10 kt, 11–20 kt, > 20 kt) of hourly observations.
model WindClimate {
  id           String   @id @default(cuid())
  stationId    String   @unique // NUM_POSTE
  name         String
  latitude     Float
  longitude    Float
  altitudeM    Int?
  periodStart  Int // first year
  periodEnd    Int // last year
  observations Int // hours with a valid wind
  calm         Int // hours below 1 kt
  counts       Json
  updatedAt    DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("wind_climate")
  @@schema("public")
}

// Weather webcam listed by Cam-Aéro (cam-aero.eu). Only the link to its
// viewer page is kept: images are never loaded or copied.
model Webcam {
  id          String    @id @default(cuid())
  aerodromeId String
  sourceId    String    @unique // Cam-Aéro camera name, e.g. "LFBP_AeroclubDuBearn"
  label       String
  pageUrl     String
  lastImageAt DateTime?
  updatedAt   DateTime  @updatedAt

  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@index([aerodromeId])
  @@map("webcams")
  @@schema("public")
}

// Main photo of an aerodrome, from its Wikidata item (P18) on Wikimedia
// Commons. A re-encoded copy is kept in our storage so that visitors never
// load anything from Wikimedia; the credit is shown with the photo.
model CommonsPhoto {
  id          String   @id @default(cuid())
  aerodromeId String   @unique
  wikidataId  String // e.g. "Q2886463"
  fileTitle   String // "File:…" on Commons
  pageUrl     String // Commons description page, linked in the credit
  sourceSha1  String // unchanged on Commons → no new download
  author      String? // plain text, HTML stripped
  license     String // short name as on Commons, e.g. "CC BY-SA 4.0"
  licenseUrl  String?
  storedKey   String // S3 object key of our copy
  thumbKey    String? // small copy for result lists; null until the next import
  mimeType    String
  width       Int
  height      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  aerodrome Aerodrome @relation(fields: [aerodromeId], references: [id], onDelete: Cascade)

  @@map("commons_photos")
  @@schema("public")
}

model Airspace {
  id           String  @id @default(cuid())
  name         String
  // openAIP type code (0=Other, 1=Restricted, 2=Danger, 3=Prohibited, 4=CTR, 5=TMA,
  //   6=RMZ, 7=TMZ, 8=FIR, 9=UIR, 10=ADIZ, 11=ATZ, 12=MATZ, 13=Airway,
  //   14=MTR, 15=Alert, 16=Warning, 17=Protected, 18=HTZ, 19=Glider, 20=TRP,
  //   21=TIZ, 22=TIA, 23=MBZ, 24=GP, 25=WTSZ, 26=NOTAM)
  type         Int
  // ICAO class: A B C D E F G or special codes
  icaoClass    String
  // Altitude limits — stored as human-readable strings (e.g. "SFC", "FL065", "3500ft MSL")
  lowerLimit   String
  upperLimit   String
  // Raw limit values for filtering
  lowerLimitFt Int? // feet MSL, null = SFC (0) or unknown
  upperLimitFt Int? // feet MSL, null = unlimited or unknown
  // GeoJSON polygon geometry (type: "Polygon" | "MultiPolygon", coordinates: ...)
  geometry     Json
  countryCode  String  @default("FR")
  // openAIP specific
  activity     Int? // 0=All, 1=Parachute, 2=Aerobatic, 3=Airshow, 4=Glider...
  onDemand     Boolean @default(false)
  onRequest    Boolean @default(false)
  remarks      String?

  sourceId      String?
  sourceRawHash String?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId])
  @@index([type])
  @@index([icaoClass])
  @@index([countryCode])
  @@map("airspaces")
  @@schema("public")
}

// ─── OSM data (schema: osm) ──────────────────────────────
// Populated by `pnpm import:osm` — never written by the app at runtime.
// Isolated in the `osm` PostgreSQL schema to keep app migrations clean.

model OsmPoi {
  osmId    String @id // "node/123456" | "way/789"
  lat      Float
  lon      Float
  category String // "RESTAURANT" | "TRANSPORT" | "BIKE"
  tags     Json // raw OSM tags — mirrors OverpassElement.tags

  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category, lat, lon])
  @@map("pois")
  @@schema("osm")
}
